{
  "multipart": [
    {
      "when": {
        "fruiting": "false"
      },
      "apply": {
        "model": "flavor_immersed_daily:block/walnutleaves_fruiting_leaves"
      }
    },
    {
      "when": {
        "fruiting": "true"
      },
      "apply": {
        "model": "flavor_immersed_daily:block/walnutleaves_fruiting_leaves_mature"
      }
    }
  ]
}
